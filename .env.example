# =============================================================================
# AI PB — 환경 변수 예시
# 사용법: cp .env.example .env  후 값을 채운다. .env 는 절대 커밋하지 않는다.
# =============================================================================

# ── Database (PostgreSQL + pgvector) ─────────────────────────────────────────
POSTGRES_DB=aipb
POSTGRES_USER=aipb
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://postgres:5432/aipb

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Object Storage (MinIO, S3 호환) ──────────────────────────────────────────
MINIO_ROOT_USER=aipb-minio
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=aipb-documents
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Security ─────────────────────────────────────────────────────────────────
# JWT_SECRET: HS256 기준 최소 32바이트. 생성 예) openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-bytes-long-secret-value
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
# AES_KEY: 개인정보 컬럼 암호화 키(AES-256-GCM). 생성 예) openssl rand -base64 32
AES_KEY=change-me-base64-encoded-32-byte-key
# HMAC_KEY: 이메일 등 조회용 해시 키
HMAC_KEY=change-me-base64-encoded-32-byte-key

# ── LLM / Embedding ──────────────────────────────────────────────────────────
# LLM_PROVIDER: anthropic | openai | stub
#   stub = LlmClient 스텁 구현체. 개발/테스트 중 실제 API 호출 없이 고정 응답 반환.
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1500

EMBEDDING_PROVIDER=stub
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ── RAG 하이퍼파라미터 (설계서 8.3 기준 초기값) ──────────────────────────────
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_VECTOR_TOP_N=30
RAG_KEYWORD_TOP_N=30
RAG_RRF_K=60
RAG_RERANK_TOP_K=5
RAG_SCORE_THRESHOLD=0.35
RAG_CONTEXT_TOKEN_LIMIT=3000

# ── 정책 / 프롬프트 버전 (사고 시 재배포 없이 롤백하는 스위치) ───────────────
PROMPT_VERSION=v1
POLICY_VERSION=v1
RULE_VERSION=v1

# ── Rate Limit ───────────────────────────────────────────────────────────────
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_DAY=100

# ── App ──────────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local
API_PORT=8080
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
